name: TraceHarbor PRIVATE42 candidate INACTIVE
on:
  workflow_dispatch:
    inputs:
      phase:
        type: choice
        options: [first, second]
        required: true
      source_sha:
        type: string
        required: true
      workflow_sha256:
        type: string
        required: true
      driver_sha256:
        type: string
        required: true
      validator_sha256:
        type: string
        required: true
permissions: {}
jobs:
  writer:
    if: ${{ false && inputs.phase == 'first' }}
    permissions:
      contents: write
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: INACTIVE existing admission gate remains unbound
        env:
          Q27_ADMITTED: 'NO'
          Q27_PHASE: ${{ inputs.phase }}
          Q27_SOURCE: ${{ inputs.source_sha }}
          Q27_WORKFLOW_HASH: ${{ inputs.workflow_sha256 }}
          Q27_DRIVER_HASH: ${{ inputs.driver_sha256 }}
        run: python3 -B qualification/native27.py
  readback65:
    name: readback65
    if: ${{ false && inputs.phase == 'second' }}
    permissions:
      contents: read
      actions: read
      id-token: write
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - id: traceharbor_readback66
        name: INACTIVE67 same-process OIDC producer and readback
        env:
          TRACEHARBOR_READONLY_JOB_TOKEN: ${{ github.token }}
        run: python3 -B qualification/native27_readback59.py
# PRIVATE65 only: both literal-false guards remain. No deployment/dispatch.
# Future readback65 identity: provider-signed OIDC + exact REST job membership;
# only this job has id-token:write; writer cannot mint its identity here.
# No job token is accessed by default; custody is lazy after real verification. Future admission66 must bind exact final source,
# dependency integrity, read-only job-token custody and genuine redirect authority.
# Both current CLIs refuse BEFORE any token lookup or connection.
# PRIVATE67: native_cli66 now invokes same-process GitHub OIDC acquisition.
# URL is an input checked against one independently reviewed exact provider
# origin/path/query policy BEFORE request bearer access. JWT verification and
# original public run/job/source context precede readonly job-token access.
# No stdin pipe, extra action, service, broker or token output is used.
# Request policy, reviewed selectors/admission/redirect remainNone; both guards
# stay literalfalse. No job dispatch, new dependency or native effect here.
