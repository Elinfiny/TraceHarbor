name: TraceHarbor PRIVATE42 candidate INACTIVE
on:
  workflow_dispatch:
    inputs:
      phase:
        type: choice
        options: [first, second]
        required: true
      source_sha:
        type: string
        required: true
      workflow_sha256:
        type: string
        required: true
      driver_sha256:
        type: string
        required: true
      validator_sha256:
        type: string
        required: true
permissions: {}
jobs:
  writer:
    if: ${{ false && inputs.phase == 'first' }}
    permissions:
      contents: write
    runs-on: ubuntu-latest
    timeout-minutes: 2
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: INACTIVE existing admission gate remains unbound
        env:
          Q27_ADMITTED: 'NO'
          Q27_PHASE: ${{ inputs.phase }}
          Q27_SOURCE: ${{ inputs.source_sha }}
          Q27_WORKFLOW_HASH: ${{ inputs.workflow_sha256 }}
          Q27_DRIVER_HASH: ${{ inputs.driver_sha256 }}
        run: python3 -B qualification/native27.py
  validator:
    needs: [writer]
    if: ${{ false && needs.writer.result == 'success' && inputs.phase == 'first' }}
    permissions:
      contents: read
      actions: read
    runs-on: ubuntu-latest
    timeout-minutes: 1
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ inputs.source_sha }}
          persist-credentials: false
      - name: INACTIVE mechanical validator; native transport unbound
        run: python3 -B qualification/native27_validator42.py
# No SECOND job, active path, outputs-as-authority or dispatch here.
# Job-scoped read permissions are for future checkout/authenticated read adapters.
# No token is passed between jobs. Both CLIs refuse by default. Future same-source
# admission must bind real source/hash/workflowID externally before either phase.
