name: TraceHarbor dormant ONE94
on:
  workflow_dispatch:
permissions: {}
jobs:
  one94:
    if: false
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    permissions:
      contents: write
      actions: read
      id-token: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      # No install chain, dispatch, protected mount or secret injection94.
      # Reviewed activation must bind the exact promoted source/workflow SHA,
      # protected admission/capture and qualified dependency closure first.
      - name: Exact dormant source entry
        run: python3 one_native94.py
